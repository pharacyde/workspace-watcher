"A single observation about the workspace."
type WatchEvent {
  seq: ID!
  "ISO-8601 instant."
  ts: String!
  """
  How this event is known. TRANSCRIPT and HOOK carry real attribution straight from the agent;
  FS is the generic safety net and claims no actor.
  """
  source: Source!
  "CREATED, MODIFIED, TOOL_USE, TOOL_ERROR, STATUS, SNAPSHOT, …"
  type: String!
  summary: String
  "Workspace-relative path, when the event is about one file."
  path: String
  pid: ID
  "Which agent produced this, when known. Always null for FS events."
  agent: String
  sessionId: String
  "Raw payload as a JSON string. Shape depends on source; treat as opaque."
  detail: String
}

"""
What a guard rule does when it matches.

ALLOW is the absence of a decision, WARN records the match and lets the call through, and DENY
blocks it - but only while the guard is enforcing. With the guard observing, a DENY rule still
produces an event, so you can see what would have been stopped before letting it stop anything.
"""
enum GuardAction {
  ALLOW
  WARN
  DENY
}

enum GuardRuleKind {
  "Glob matched against a file path the tool is about to touch."
  PATH
  "Regular expression matched against a shell command."
  COMMAND
}

type GuardRule {
  kind: GuardRuleKind!
  pattern: String!
  action: GuardAction!
  reason: String
}

type GuardConfig {
  "False means observe only: rules still produce events but nothing is ever blocked."
  enabled: Boolean!
  "Block any file outside the watched workspace."
  denyOutsideWorkspace: Boolean!
  rules: [GuardRule!]!
}

type GuardDecision {
  action: GuardAction!
  reason: String
  "The rule that matched, for the audit trail."
  rule: String
}

input GuardRuleInput {
  kind: GuardRuleKind!
  pattern: String!
  action: GuardAction!
  reason: String
}

enum Source {
  "Parsed from an agent's own session transcript. Attribution is exact."
  TRANSCRIPT
  "Pushed by an agent hook at the moment of the action. Attribution is exact."
  HOOK
  "Raw filesystem change. No actor is known - do not guess one."
  FS
  "A guard rule matched something an agent was about to do."
  GUARD
  "The watcher talking about itself."
  SYSTEM
}

type FileStatus {
  path: String!
  "untracked, modified, added, deleted or renamed."
  status: String!
  staged: Boolean!
}

type GitSnapshot {
  repo: Boolean!
  branch: String
  head: String
  headSubject: String
  files: [FileStatus!]!
}

type ProcessNode {
  pid: ID!
  command: String!
  cwd: String!
  children: [ProcessNode!]!
}

"""
The two sides of a file, for a side-by-side diff view. A unified diff string cannot drive one:
the editor needs both documents, not a description of their difference.
"""
type FileVersions {
  path: String!
  "Content at HEAD. Empty for an untracked or newly added file."
  head: String!
  "Content on disk right now. Empty for a deleted file."
  working: String!
  "True when the content is not text; both sides are then empty."
  binary: Boolean!
  "True when the file exceeds the diff size limit; both sides are then empty."
  tooLarge: Boolean!
}

"Process tree at a moment in time. Sampled, therefore incomplete by nature."
type ProcessSnapshot {
  at: String!
  total: Int!
  roots: [ProcessNode!]!
}

"""
A workspace that has registered itself by an agent hook firing in it.

Registration needs no configuration: the hook writes a spool directory named after the project the
first time it runs there, so a project enrols itself the moment an agent does anything in it.
"""
type WorkspaceEntry {
  path: String!
  "ISO-8601 instant of the most recent hook activity."
  lastActivity: String!
  "Hook events waiting on disk for a watcher to pick them up."
  pendingEvents: Int!
  "False when the directory has since been deleted or moved."
  exists: Boolean!
}

"""
An agent session in the watched workspace.

One workspace often has several agents working in it at once, in separate terminals. Every
TRANSCRIPT and HOOK event carries the session that produced it, so this is the second filter: pick
a workspace, then pick which agent in it to follow.
"""
type SessionEntry {
  id: String!
  "Title Claude Code generated for the session, when it has written one yet."
  title: String
  lastActivity: String!
  "True while the transcript is still being written to."
  live: Boolean!
}

"How many events fell in one slice of a timeline, and how many of those an agent caused."
type ActivityBucket {
  index: Int!
  "ISO-8601 instant this slice starts at."
  from: String!
  count: Int!
  "Events from TRANSCRIPT or HOOK. A thousand file events is noise; ten tool calls is the story."
  agentCount: Int!
}

type Status {
  "Null until a workspace has been chosen or discovered."
  workspace: String
  workspaceExists: Boolean!
  os: String!
  "Transcript directories being tailed. Empty means nothing will be attributed to an agent."
  transcriptDirs: [String!]!
  git: GitSnapshot!
  processes: ProcessSnapshot!
}

type Query {
  status: Status!
  "Both sides of a file. The path is as gitStatus reports it, relative to the repository root."
  fileVersions(path: String!): FileVersions!
  "Most recent events from the in-memory buffer, oldest first."
  recentEvents(limit: Int = 200): [WatchEvent!]!

  "Every workspace that has registered itself, most recently active first."
  workspaces: [WorkspaceEntry!]!

  "Agent sessions in the watched workspace, most recently active first."
  sessions: [SessionEntry!]!

  """
  Activity density over a range, for a timeline to draw. Counted in the database rather than by
  returning the rows: a month is millions of events and a timeline needs a few hundred numbers.
  """
  activity(
    workspace: String
    since: String!
    until: String!
    buckets: Int = 240
  ): [ActivityBucket!]!

  "Guard rules, and whether they are being enforced or only observed."
  guard: GuardConfig!

  """
  Recorded history, oldest first. Unlike the live feed this outlives a restart: the in-memory
  buffer holds minutes, this holds weeks.

  Defaults to the workspace being watched. `since` is inclusive and `until` exclusive, both
  ISO-8601; omit either for an open end.
  """
  history(
    workspace: String
    since: String
    until: String
    limit: Int = 500
  ): [WatchEvent!]!
}

type Mutation {
  """
  Points the watcher at a workspace. It takes effect within one polling interval; nothing restarts.

  The path must be a directory. Anything already registered is a safe argument, but any directory
  works - registration is a convenience, not a requirement.
  """
  watchWorkspace(path: String!): Boolean!

  """
  Removes a workspace registration. Only the spool directory is deleted; the project is untouched.

  Registration happens by itself when an agent works somewhere, so a hook fired once from the wrong
  directory, or a project since deleted, would otherwise stay in the list forever.
  """
  forgetWorkspace(path: String!): Boolean!

  "Replaces the guard configuration and persists it."
  setGuard(
    enabled: Boolean!
    denyOutsideWorkspace: Boolean!
    rules: [GuardRuleInput!]!
  ): GuardConfig!

  """
  Decides one tool call, for a PreToolUse hook to act on. Records the decision either way.

  Fails open by design: a hook blocks the agent until it answers, so a watcher that is slow or gone
  must let the call through rather than wedge the agent with it. This is a guardrail against an
  agent's mistakes, not a boundary against a determined one.
  """
  checkToolUse(payloadBase64: String!): GuardDecision!

  """
  Records an agent hook payload. The payload is the agent's raw hook JSON, base64-encoded:
  that keeps the shell side free of quoting bugs and needs no jq or python on the host.

  Always returns true. An observer must never be able to block or alter the agent it watches,
  so a malformed payload is recorded as-is rather than rejected.
  """
  recordAgentEvent(payloadBase64: String!): Boolean!
}

type Subscription {
  """
  The chronicle: things that happened, in order. Replays the buffered history first, so a
  dashboard opened mid-session is never blank, then continues live without duplicating any.

  Deliberately excludes state. Republishing an unchanged process list into a chronological feed
  is what turns a dashboard into noise - measured at 91% of all events before the split.
  """
  events: WatchEvent!

  "Current working tree. Emits the present value on subscribe, then on every change."
  gitStatus: GitSnapshot!

  "Current process tree. Emits the present value on subscribe, then on every change."
  processTree: ProcessSnapshot!

  "The register of known workspaces. Emits the present value on subscribe, then on every change."
  workspaces: [WorkspaceEntry!]!

  "The workspace being watched. Emits on subscribe and whenever it is switched."
  activeWorkspace: String!

  "Agent sessions in the watched workspace. Emits the present value on subscribe."
  sessions: [SessionEntry!]!
}
